TZ=UTC
NODE_ENV=development
APP_NAME=data-integration-platform
HOST=0.0.0.0
PORT=3333
APP_URL=http://localhost:3333
LOG_LEVEL=info
# Public development-only key for the two-command bootstrap. Replace for deployment.
# Generate a private key with: node ace generate:key
APP_KEY=0123456789abcdef0123456789abcdef

# Host settings for local Node.js; Compose overrides hosts with service names.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=platform
DB_PASSWORD=platform_dev_password
DB_DATABASE=data_integration
DB_TEST_DATABASE=data_integration_test

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_DRIVER=redis

# Local external provider mock; Compose overrides the URL with its service name.
CARRIER_API_URL=http://127.0.0.1:4001
CARRIER_API_TOKEN=carrier-demo-token
CARRIER_API_TIMEOUT_MS=3000
